<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permitir acceso directo a scripts PHP de la API
  RewriteRule ^api/ - [L]

  # Si el archivo o directorio solicitado existe, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Soporte para URLs limpias de Next.js (admision -> admision.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Redireccionar el resto a 404 o index.html si es SPA
  ErrorDocument 404 /404.html
</IfModule>

# Seguridad y Cabeceras
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
